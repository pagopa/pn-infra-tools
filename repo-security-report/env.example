# Copy to .env in this folder (or the working directory) and fill in values.
# Already-exported environment variables are not overwritten.

# GitHub (required)
GH_TOKEN=

# Confluence (required for --confluence)
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=
